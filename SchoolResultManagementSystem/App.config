<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>

  <!--
    Default XAMPP MySQL settings: host localhost, user root, no password.
    Update Pwd= if you've set a root password in your XAMPP MySQL instance.
  -->
  <connectionStrings>
    <add name="SchoolResultDb"
         connectionString="Server=localhost;Port=3306;Database=school_result_db;Uid=root;Pwd=;"
         providerName="MySql.Data.MySqlClient" />
  </connectionStrings>
</configuration>
